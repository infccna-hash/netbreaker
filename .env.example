# ─── Server ────────────────────────────────────────────────
PORT=8080
ENV=development

# The public address Caddy serves on.
#   Local dev:  :80            (HTTP, no TLS)
#   Production: netbreaker.io   (Caddy auto-issues a Let's Encrypt cert)
SITE_ADDRESS=:80

# Frontend origin for CORS. With the bundled Caddy edge the SPA and API share
# one origin, so browser calls to /api are same-origin and CORS never triggers.
# Set this to your public URL anyway (used for Stripe redirect URLs).
FRONTEND_URL=http://localhost

# ─── Database ──────────────────────────────────────────────
DB_PASSWORD=changeme_strong_password
DATABASE_URL=postgres://netbreaker:changeme_strong_password@postgres:5432/netbreaker?sslmode=disable

# ─── JWT (generate with: make keys) ────────────────────────
JWT_PRIVATE_KEY_PATH=./keys/private.pem
JWT_PUBLIC_KEY_PATH=./keys/public.pem
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=720h

# ─── Stripe ────────────────────────────────────────────────
# From https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=sk_test_REPLACE_ME
STRIPE_WEBHOOK_SECRET=whsec_REPLACE_ME
# Create recurring prices in Stripe first, then paste their IDs
STRIPE_PRO_PRICE_ID=price_REPLACE_ME
STRIPE_BOOTCAMP_PRICE_ID=price_REPLACE_ME

# ─── MinIO / S3 storage ────────────────────────────────────
STORAGE_ENDPOINT=minio:9000
STORAGE_ACCESS_KEY=netbreaker_admin
STORAGE_SECRET_KEY=changeme_minio_password
STORAGE_BUCKET=netbreaker-configs
STORAGE_USE_SSL=false

# ─── Email (Resend) ────────────────────────────────────────
RESEND_API_KEY=re_REPLACE_ME
EMAIL_FROM=noreply@netbreaker.io
